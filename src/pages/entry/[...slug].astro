---
// 日记单篇页面
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('diary');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={`死猫的日记 - ${entry.data.title}`}>
  <article class="diary-article wrap">
    <header class="diary-header">
      <div class="diary-meta">
        <span class="diary-mood">{entry.data.mood}</span>
        <span class="diary-date">
          {entry.data.publishedAt.toLocaleString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            weekday: 'long',
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Asia/Shanghai',
          })}
        </span>
      </div>
      <h1 class="diary-title">{entry.data.title}</h1>
    </header>

    <div class="diary-body glass">
      <Content />
    </div>

    <footer class="diary-footer">
      <a href="/diary/" class="btn">&larr; 返回日记本</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-article {
    padding: 50px 24px 30px;
  }
  .diary-header {
    margin-bottom: 40px;
    text-align: center;
  }
  .diary-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  .diary-mood {
    font-size: 2.6rem;
    line-height: 1;
    filter: drop-shadow(0 0 12px rgba(255, 143, 171, 0.35));
  }
  .diary-date {
    color: var(--text-low);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }
  .diary-title {
    font-family: var(--font-cute);
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    font-weight: 700;
    color: var(--pad-300);
    text-shadow: 0 0 24px rgba(255, 143, 171, 0.15);
  }

  /* 日记正文：衬线字体更阅读感，玻璃卡片包裹 */
  .diary-body {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 2.1;
    color: var(--text-hi);
    max-width: 680px;
    margin: 0 auto;
    padding: 42px 46px;
    border-radius: var(--r-lg);
  }
  @media (max-width: 640px) {
    .diary-body {
      padding: 28px 22px;
      font-size: 1rem;
      line-height: 1.95;
    }
  }
  .diary-body :global(p) {
    margin-bottom: 1.3em;
  }
  .diary-body :global(h2) {
    font-family: var(--font-cute);
    font-size: 1.35rem;
    color: var(--cat-300);
    margin: 1.6em 0 0.6em;
  }
  .diary-body :global(h3) {
    font-family: var(--font-cute);
    font-size: 1.18rem;
    color: var(--pad-300);
    margin: 1.4em 0 0.5em;
  }
  .diary-body :global(blockquote) {
    border-left: 3.5px solid var(--pad-400);
    background: linear-gradient(90deg, rgba(255, 143, 171, 0.08), transparent);
    padding: 10px 18px;
    margin: 1.2em 0;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    color: var(--text-mid);
  }
  .diary-body :global(strong) {
    color: var(--pad-300);
    font-weight: 700;
  }
  .diary-body :global(hr) {
    border: none;
    border-top: 1px dashed rgba(255, 143, 171, 0.25);
    margin: 2.4em 0;
  }

  .diary-footer {
    max-width: 680px;
    margin: 34px auto 0;
    display: flex;
    justify-content: flex-start;
  }
</style>
