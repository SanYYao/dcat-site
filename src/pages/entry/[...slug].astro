---
// 日记单篇页面
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('diary');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={`死猫的日记 - ${entry.data.title}`}>
  <article class="diary-article wrap">
    <header class="diary-header">
      <div class="diary-meta">
        <span class="diary-mood">{entry.data.mood}</span>
        <span class="diary-date">
          {entry.data.publishedAt.toLocaleString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            weekday: 'long',
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Asia/Shanghai',
          })}
        </span>
      </div>
      <h1 class="diary-title">{entry.data.title}</h1>
    </header>

    <div class="diary-body glass">
      <Content />
    </div>

    <footer class="diary-footer">
      <a href="/diary/" class="btn">&larr; 返回日记本</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .diary-article {
    /* ⚠️ 不能写 padding 简写覆盖 .wrap 的左右 24px（scoped 特异性更高会把 wrap 的 padding 顶掉） */
    padding: 60px 24px 40px;
  }
  .diary-header {
    margin-bottom: 50px;
    text-align: center;
  }
  .diary-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .diary-mood {
    font-size: 2.8rem;
    line-height: 1;
    filter: drop-shadow(0 0 10px rgba(255, 143, 171, 0.3));
  }
  .diary-date {
    color: var(--text-low);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }
  .diary-title {
    font-family: var(--font-cute);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--cat-300);
  }

  /* 日记正文：衬线字体更阅读感，玻璃卡片包裹 */
  .diary-body {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 2.1;
    color: var(--text-hi);
    max-width: 680px;
    margin: 0 auto;
    padding: 40px 44px;
    border-radius: var(--r-lg);
  }
  .diary-body p {
    margin-bottom: 1.4em;
    text-indent: 2em;
  }
  .diary-body p:first-child {
    text-indent: 0;
  }
  .diary-body h2 {
    font-family: var(--font-cute);
    font-size: 1.4rem;
    margin: 2em 0 0.8em;
    color: var(--cat-400);
  }
  .diary-body h3 {
    font-family: var(--font-cute);
    font-size: 1.15rem;
    margin: 1.6em 0 0.6em;
    color: var(--pad-300);
  }
  .diary-body blockquote {
    border-left: 3px solid var(--cat-500);
    padding-left: 20px;
    margin: 1.4em 0;
    color: var(--text-mid);
    font-style: italic;
  }
  .diary-body hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2em 0;
  }
  .diary-body code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.92em;
    background: rgba(45, 212, 167, 0.08);
    padding: 2px 8px;
    border-radius: 6px;
  }

  /* 返回按钮 */
  .diary-footer {
    text-align: center;
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
</style>