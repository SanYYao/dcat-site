---
// 文章详情页 —— /articles/[slug]/
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('articles')).filter(
    (p) => !p.data.draft && !p.data.private
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishedAt, tags = [] } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <div class="wrap article-wrap">
      <header class="article-head">
        <p class="article-date">
          {publishedAt.toLocaleString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Shanghai' })}
        </p>
        <h1 class="article-title">{title}</h1>
        <div class="article-tags">
          {
            tags.map((tag) => <span class="tag">#{tag}</span>)
          }
        </div>
      </header>

      <div class="article-body glass">
        <Content />
      </div>

      <nav class="article-foot">
        <a class="btn" href="/#articles">← 回文章列表</a>
        <div class="article-foot-paw">
          <span class="foot-paw" title="死猫留下的爪印">🐾</span>
        </div>
      </nav>

      <!-- 回到顶部按钮：下滑超过一屏才显示 -->
      <button class="back-top" id="backTop" aria-label="回到顶部" title="回到顶部">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5"/>
          <path d="M5 12l7-7 7 7"/>
        </svg>
      </button>
    </div>
  </article>

  <style>
    .article { padding: 50px 0 30px; }
    .article-wrap { max-width: 700px; }
    .article-head { text-align: center; margin-bottom: 34px; }
    .article-date { color: var(--text-low); font-size: 0.88rem; margin-bottom: 12px; }
    .article-title {
      font-family: var(--font-cute);
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      font-weight: 700;
      margin-bottom: 16px;
      line-height: 1.35;
      text-shadow: 0 0 30px rgba(45, 212, 167, 0.1);
    }
    .article-tags { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    .tag {
      font-size: 0.8rem;
      font-family: var(--font-cute);
      color: var(--cat-300);
      background: rgba(45, 212, 167, 0.12);
      padding: 3px 12px;
      border-radius: 999px;
      border: 1px solid rgba(45, 212, 167, 0.28);
    }

    .article-body {
      padding: 42px 46px;
      font-family: var(--font-serif);
      font-size: 1.05rem;
      line-height: 2.1;
      color: var(--text-hi);
    }

    @media (max-width: 640px) {
      .article-body {
        padding: 28px 22px;
        font-size: 1rem;
        line-height: 1.95;
      }
    }

    /* Markdown 排版细节 */
    .article-body :global(h1) {
      font-family: var(--font-cute);
      font-size: 1.75rem;
      margin: 1.8em 0 0.7em;
      padding-bottom: 0.4em;
      border-bottom: 1px solid var(--line);
      color: var(--cat-300);
    }
    .article-body :global(h2) {
      font-family: var(--font-cute);
      font-size: 1.45rem;
      margin: 1.6em 0 0.6em;
      color: var(--text-hi);
      position: relative;
    }
    .article-body :global(h3) {
      font-family: var(--font-cute);
      font-size: 1.25rem;
      margin: 1.4em 0 0.5em;
      color: var(--pad-300);
    }
    .article-body :global(p) { margin: 1.1em 0; }
    .article-body :global(strong) {
      color: var(--cat-300);
      font-weight: 700;
    }
    .article-body :global(em) {
      color: var(--pad-300);
      font-style: italic;
    }
    .article-body :global(ul), .article-body :global(ol) {
      margin: 1em 0;
      padding-left: 1.8em;
    }
    .article-body :global(li) { margin: 0.5em 0; }
    .article-body :global(li::marker) {
      color: var(--cat-400);
    }
    .article-body :global(hr) {
      border: none;
      border-top: 1px dashed rgba(45, 212, 167, 0.25);
      margin: 2.6em 0;
      position: relative;
    }
    .article-body :global(hr::after) {
      content: "🐾";
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--night-800);
      padding: 0 8px;
      font-size: 0.9rem;
      color: var(--cat-400);
    }
    .article-body :global(a) {
      color: var(--cat-400);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: all 0.2s;
    }
    .article-body :global(a:hover) {
      color: var(--cat-300);
      text-shadow: 0 0 12px var(--cat-glow);
    }
    .article-body :global(blockquote) {
      border-left: 3.5px solid var(--cat-400);
      background: linear-gradient(90deg, rgba(45, 212, 167, 0.08), rgba(255, 143, 171, 0.03));
      padding: 12px 20px;
      margin: 1.4em 0;
      border-radius: 0 var(--r-sm) var(--r-sm) 0;
      color: var(--text-mid);
      font-style: normal;
    }
    .article-body :global(code) {
      font-family: "JetBrains Mono", ui-monospace, "Cascadia Code", monospace;
      font-size: 0.88em;
      background: rgba(238, 241, 250, 0.08);
      color: var(--cat-300);
      padding: 2px 7px;
      border-radius: 6px;
      border: 1px solid rgba(238, 241, 250, 0.06);
    }
    .article-body :global(pre) {
      background: var(--night-950);
      border: 1px solid var(--line-strong);
      border-radius: var(--r-sm);
      padding: 18px 22px;
      overflow-x: auto;
      margin: 1.4em 0;
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.5);
    }
    .article-body :global(pre code) {
      background: none;
      padding: 0;
      border: none;
      color: var(--text-hi);
    }

    .article-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 34px;
      padding: 0 4px;
    }
    .article-foot-paw {
      display: inline-flex;
      align-items: center;
    }
    .foot-paw {
      color: var(--cat-400);
      font-size: 1.4rem;
      opacity: 0.7;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s;
      cursor: pointer;
    }
    .foot-paw:hover {
      transform: scale(1.3) rotate(-15deg);
      opacity: 1;
    }

    /* 回到顶部按钮 */
    .back-top {
      position: fixed;
      right: 24px;
      bottom: 32px;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 1px solid rgba(45, 212, 167, 0.35);
      background: rgba(18, 21, 42, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: var(--cat-400);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 8px 30px -8px rgba(0, 0, 0, 0.6), 0 0 20px -8px var(--cat-glow);
      z-index: 60;
    }
    .back-top.show {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .back-top:hover {
      border-color: rgba(45, 212, 167, 0.7);
      color: #fff;
      background: var(--night-700);
      box-shadow: 0 8px 30px -8px rgba(0, 0, 0, 0.6), 0 0 28px -4px var(--cat-glow);
      transform: translateY(-2px);
    }
    .back-top:active { transform: translateY(0) scale(0.92); }
  </style>

  <script>
    // 回到顶部：下滑超过一屏才显示
    const backTop = document.getElementById('backTop');
    if (backTop) {
      const onScroll = () => {
        const threshold = window.innerHeight || document.documentElement.clientHeight;
        backTop.classList.toggle('show', window.scrollY > threshold);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      backTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</BaseLayout>
