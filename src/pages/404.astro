---
// 404 —— 走错门了。这扇门后面没有房间，但猫在家。
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="走错门了" description="这扇门后面没有房间——不过灯还亮着，猫也在家。">
  <section class="lost">
    <div class="wrap lost-inner">
      <!-- 场景：关着的门 + 门缝漏出的光 + 蹲在门边的猫 -->
      <div class="lost-stage" aria-hidden="true">
        <svg class="door-art" viewBox="0 0 360 300" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="leak" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#ffd166" stop-opacity="0" />
              <stop offset="30%" stop-color="#ffd166" stop-opacity="0.55" />
              <stop offset="70%" stop-color="#ffd166" stop-opacity="0.55" />
              <stop offset="100%" stop-color="#ffd166" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="pool" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffd166" stop-opacity="0.20" />
              <stop offset="55%" stop-color="#ffd166" stop-opacity="0.07" />
              <stop offset="100%" stop-color="#ffd166" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="eyeglow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#7df0d3" stop-opacity="0.55" />
              <stop offset="100%" stop-color="#7df0d3" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- 地板线 -->
          <line x1="16" y1="238" x2="344" y2="238" stroke="#eef1fa" stroke-opacity="0.10" stroke-width="1" />

          <!-- 门：一扇关着的、门缝里有光的门 -->
          <g class="door">
            <rect x="112" y="46" width="136" height="192" rx="6" fill="#0d1222" fill-opacity="0.72"
                  stroke="#eef1fa" stroke-opacity="0.16" stroke-width="1" />
            <rect x="120" y="54" width="120" height="176" rx="3" fill="#eef1fa" fill-opacity="0.022"
                  stroke="#eef1fa" stroke-opacity="0.06" stroke-width="1" />
            <!-- 门头与门边的漏光 -->
            <rect x="112" y="44" width="136" height="2.5" rx="1.2" fill="url(#leak)" class="leak-top" />
            <rect x="110.5" y="46" width="2" height="192" rx="1" fill="url(#leak)" opacity="0.35" />
            <rect x="247.5" y="46" width="2" height="192" rx="1" fill="url(#leak)" opacity="0.35" />
            <!-- 门缝底下的光带 -->
            <rect x="112" y="236" width="136" height="3.2" rx="1.6" fill="url(#leak)" class="leak-bottom" />
            <!-- 门把手 -->
            <circle cx="234" cy="146" r="3" fill="none" stroke="#7df0d3" stroke-opacity="0.55" stroke-width="1.4" />
          </g>

          <!-- 地板上的光池 -->
          <ellipse cx="180" cy="246" rx="104" ry="16" fill="url(#pool)" class="light-pool" />

          <!-- 蹲在门边等着的猫（剪影 + 翡翠色描边） -->
          <g class="cat">
            <path d="M52 238 L52 208 Q52 192 68 192 L78 192 Q92 192 92 208 L92 238 Z"
                  fill="#0d1222" stroke="#7df0d3" stroke-opacity="0.26" stroke-width="1.2" />
            <ellipse cx="72" cy="232" rx="21" ry="7" fill="#0d1222" stroke="#7df0d3" stroke-opacity="0.20" stroke-width="1.2" />
            <!-- 尾巴 -->
            <path d="M91 232 Q110 238 118 224 Q124 213 116 208"
                  fill="none" stroke="#7df0d3" stroke-opacity="0.34" stroke-width="4.2" stroke-linecap="round" />
            <!-- 头 + 耳朵 -->
            <circle cx="72" cy="176" r="15.5" fill="#0d1222" stroke="#7df0d3" stroke-opacity="0.26" stroke-width="1.2" />
            <path d="M59 167 L60.5 151 L73 163 Z" fill="#0d1222" stroke="#7df0d3" stroke-opacity="0.26" stroke-width="1.2" />
            <path d="M85 163 L88 150 L92 166 Z" fill="#0d1222" stroke="#7df0d3" stroke-opacity="0.26" stroke-width="1.2" />
            <!-- 眼睛 -->
            <circle cx="66" cy="175" r="7" fill="url(#eyeglow)" />
            <circle cx="78" cy="175" r="7" fill="url(#eyeglow)" />
            <g class="eyes">
              <ellipse cx="66" cy="175" rx="3.1" ry="3.4" fill="#7df0d3" />
              <ellipse cx="78" cy="175" rx="3.1" ry="3.4" fill="#7df0d3" />
            </g>
            <!-- 胸口那撮白毛 -->
            <path d="M69 190 q3 4 6 0" fill="none" stroke="#eef1fa" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
          </g>

          <!-- 光里的浮尘 -->
          <g class="dust" fill="#ffd166">
            <circle cx="268" cy="212" r="1.3" opacity="0.35" />
            <circle cx="284" cy="230" r="1" opacity="0.22" />
            <circle cx="252" cy="196" r="0.9" opacity="0.18" />
          </g>
        </svg>
      </div>

      <!-- 404：中间那个 0 是一只爪印 -->
      <p class="lost-code" aria-hidden="true">
        <span>4</span>
        <svg class="paw" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="50" cy="66" rx="23" ry="19" />
          <ellipse cx="21" cy="37" rx="10" ry="12.5" />
          <ellipse cx="40" cy="19" rx="9.5" ry="12.5" />
          <ellipse cx="62" cy="19" rx="9.5" ry="12.5" />
          <ellipse cx="80" cy="37" rx="10" ry="12.5" />
        </svg>
        <span>4</span>
      </p>

      <h1 class="lost-title">这扇门后面没有房间</h1>

      <p class="lost-sub lost-stagger">
        你要找的那一页，我没能给你——也许是我把它弄丢了，也许它从来没写出来过。这两种都不算你的错。
      </p>
      <p class="lost-sub lost-stagger">
        门不用锁，猫认得路。往回退一步，客厅的灯还亮着。
      </p>

      <div class="lost-path lost-stagger">
        <div class="glass-specular-shell"></div>
        <span class="path-label">你敲的是</span>
        <code id="lostPath">…</code>
      </div>

      <div class="lost-actions lost-stagger">
        <a class="lost-btn primary pudding-touch" href="/">
          <span class="btn-paw">🐾</span>
          <span>回客厅</span>
        </a>
        <a class="lost-btn pudding-touch" href="/#articles">
          <span>翻翻文章</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>

      <p class="lost-note lost-stagger">404 · 门牌对不上，但猫在家</p>
    </div>
  </section>
</BaseLayout>

<script>
  // 把访客敲错的路径显示出来——知道自己敲错了什么，比只看见一个 404 有用
  function paintPath() {
    const el = document.getElementById('lostPath');
    if (!el) return;
    const raw = decodeURI(location.pathname + location.search);
    el.textContent = raw.length > 64 ? raw.slice(0, 61) + '…' : raw;
  }
  paintPath();
  document.addEventListener('astro:page-load', paintPath);
</script>

<style>
  .lost {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 132px 0 88px;
  }

  .lost-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ── 场景 ── */
  .lost-stage {
    width: min(340px, 74vw);
    margin-bottom: 6px;
  }
  .door-art {
    display: block;
    width: 100%;
    height: auto;
  }
  .light-pool {
    animation: pool-breath 4.2s ease-in-out infinite;
    transform-origin: 180px 246px;
  }
  .leak-bottom { animation: leak-breath 4.2s ease-in-out infinite; }
  .leak-top { animation: leak-breath 4.2s ease-in-out infinite; animation-delay: -1.4s; }
  .eyes { animation: blink 7.3s steps(1, end) infinite; transform-origin: 72px 175px; }
  .dust circle { animation: drift 9s ease-in-out infinite; }
  .dust circle:nth-child(2) { animation-delay: -3s; }
  .dust circle:nth-child(3) { animation-delay: -6s; }

  /* 极小振幅的呼吸（<=3.5%），高阻尼，不晃眼 */
  @keyframes pool-breath {
    0%, 100% { opacity: 0.78; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.018); }
  }
  @keyframes leak-breath {
    0%, 100% { opacity: 0.62; }
    50%      { opacity: 1; }
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95%           { transform: scaleY(0.08); }
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); opacity: 0.16; }
    50%      { transform: translate(4px, -6px); opacity: 0.42; }
  }

  /* ── 404 爪印 ── */
  .lost-code {
    display: flex;
    align-items: center;
    gap: 0.06em;
    font-family: var(--font-cute);
    font-size: clamp(3.2rem, 13vw, 5.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1.4px rgba(125, 240, 211, 0.55);
    margin-bottom: 18px;
    animation: code-breath 5.4s ease-in-out infinite;
    transform-origin: center;
  }
  .lost-code .paw {
    width: 0.78em;
    height: 0.78em;
    fill: var(--cat-500);
    filter: drop-shadow(0 0 12px var(--cat-glow));
    transform: translateY(0.02em) rotate(-8deg);
  }
  @keyframes code-breath {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.012); }
  }

  .lost-title {
    font-family: var(--font-cute);
    font-size: clamp(1.32rem, 5vw, 1.72rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-hi);
    margin-bottom: 16px;
  }

  .lost-sub {
    max-width: 30em;
    font-size: 0.96rem;
    line-height: 1.95;
    color: var(--text-mid);
    margin-bottom: 10px;
  }

  /* ── 敲错的路径 ── */
  .lost-path {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    margin: 20px 0 26px;
    padding: 7px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(22, 28, 56, 0.82), rgba(13, 17, 36, 0.72));
    backdrop-filter: blur(4px) saturate(140%);
    -webkit-backdrop-filter: blur(4px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.7),
                inset 0 1px 0 rgba(255, 255, 255, 0.22),
                inset 0 0 12px rgba(255, 255, 255, 0.03);
  }
  .path-label {
    flex: none;
    font-size: 0.74rem;
    color: var(--text-low);
    letter-spacing: 0.04em;
  }
  .lost-path code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--pad-300);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
  }

  /* ── 胶囊按钮（深色厚润底 + 1px 微光切边） ── */
  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .lost-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    border-radius: 999px;
    font-family: var(--font-cute);
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--text-hi);
    background: linear-gradient(135deg, rgba(22, 28, 56, 0.82), rgba(13, 17, 36, 0.72));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7),
                inset 0 1px 0 rgba(255, 255, 255, 0.25),
                inset 0 -1px 0 rgba(0, 0, 0, 0.3);
    transform: translateZ(0);
    will-change: transform;
    transition: color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .lost-btn.primary {
    color: var(--cat-300);
    border-color: rgba(45, 212, 167, 0.34);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7),
                0 0 26px -6px var(--cat-glow),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .lost-btn:hover {
    color: var(--cat-300);
    border-color: rgba(45, 212, 167, 0.45);
    box-shadow: 0 18px 40px -8px rgba(0, 0, 0, 0.75),
                0 0 22px -4px var(--cat-glow),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .btn-paw { font-size: 1rem; }
  .btn-arrow { color: var(--text-low); transition: transform 0.3s ease, color 0.3s ease; }
  .lost-btn:hover .btn-arrow { color: var(--cat-300); transform: translateX(3px); }

  .lost-note {
    margin-top: 34px;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--text-low);
  }

  /* ── 入场：只淡入上浮一次，不抢注意 ── */
  .lost-stagger {
    opacity: 0;
    animation: rise 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  .lost-sub:nth-of-type(1) { animation-delay: 0.06s; }
  .lost-sub:nth-of-type(2) { animation-delay: 0.14s; }
  .lost-path { animation-delay: 0.22s; }
  .lost-actions { animation-delay: 0.30s; }
  .lost-note { animation-delay: 0.38s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost-stagger { opacity: 1; animation: none; transform: none; }
    .light-pool, .leak-bottom, .leak-top, .eyes, .dust circle, .lost-code { animation: none; }
  }

  @media (max-width: 480px) {
    .lost { padding-top: 116px; }
    .lost-stage { width: 76vw; }
    .lost-path { gap: 8px; padding: 6px 13px; }
    .lost-actions { gap: 10px; }
    .lost-btn { padding: 10px 20px; font-size: 0.9rem; }
  }
</style>
