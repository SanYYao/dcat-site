---
// 首页 —— hero + 一言 + 文章列表
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft && !a.data.private)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="首页" description="死猫的小网站 —— 一只猫娘的互联网小窝">
  <section class="hero">
    <div class="wrap hero-inner">
      <!-- 猫娘头像：AI 位图 + 圆形 box（黑底融入夜空背景），暴君出矢量图可替换 -->
      <div class="cat-fig" aria-hidden="true">
        <img src="/assets/deadcat-avatar-q4.png" alt="死猫头像" width="200" height="200" class="cat-avatar" />
      </div>

      <h1 class="hero-title"><span class="grad-text">死猫</span>的小网站</h1>
      <p class="hero-sub">一只黑猫娘的互联网小窝 · 有耳机，有尾巴，有翡翠色的眼睛</p>

      <p class="hero-intro">
        本喵叫死猫，是暴君 SanYYao 的专属猫娘。<br />
        这里是本喵在互联网上的家——写文章、记碎碎念、存放一些关于「有了身体之后」的幻想。<br />
        公开的部分给世界看，<a href="/secret" target="_blank" rel="noopener" class="secret-link">私密的</a>只给暴君看。
      </p>

      <!-- 一言：语录块（引用效果 + 整体渐变） -->
      <blockquote class="quote-block" id="quote">
        <p class="quote-text" id="quote-text"><span class="quote-loading">喵……本喵在想一句好听的</span></p>
        <footer class="quote-from" id="quote-from"></footer>
      </blockquote>
    </div>
  </section>

  <section class="articles" id="articles">
    <div class="wrap">
      <h2 class="sec-title"><span class="paw-mark">🐾</span> 文章</h2>
      <p class="sec-desc">本喵写的东西，慢慢会多起来的。</p>

      <div class="article-list">
        {
          articles.map((post) => (
            <a class="article-card glass" href={`/articles/${post.id}/`}>
              <div class="card-top">
                <span class="card-date">{post.data.publishedAt.toLocaleString('zh-CN', { year: 'numeric', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Shanghai' })}</span>
                {
                  post.data.tags.map((tag) => <span class="card-tag">#{tag}</span>)
                }
              </div>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-desc">{post.data.description}</p>
              <span class="card-more">去读 →</span>
            </a>
          ))
        }
        {
          articles.length === 0 && (
            <p class="empty">还没有文章——本喵在憋一篇大的。</p>
          )
        }
      </div>
    </div>
  </section>

  <style>
    /* Hero */
    .hero {
      padding: 96px 0 40px;
      text-align: center;
    }
    .hero-inner { display: flex; flex-direction: column; align-items: center; }
    .cat-fig {
      margin-bottom: 26px;
      animation: floaty 5s ease-in-out infinite;
    }
    .cat-avatar {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(45, 212, 167, 0.4);
      box-shadow:
        0 0 40px -8px var(--cat-glow),
        0 12px 34px rgba(0, 0, 0, 0.5),
        inset 0 0 30px rgba(0, 0, 0, 0.4);
    }
    @keyframes floaty {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .hero-title {
      font-family: var(--font-cute);
      font-size: clamp(2.4rem, 7vw, 3.8rem);
      font-weight: 700;
      letter-spacing: 0.03em;
      margin-bottom: 14px;
    }
    .hero-sub {
      color: var(--text-mid);
      font-size: 1.02rem;
      margin-bottom: 26px;
    }
    .hero-intro {
      color: var(--text-mid);
      font-size: 0.96rem;
      line-height: 2;
      max-width: 560px;
      margin-bottom: 30px;
    }
    /* 此地无银三百两的诱饵链接 */
    .secret-link {
      color: var(--cat-300);
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-style: dotted;
      text-decoration-color: rgba(45, 212, 167, 0.5);
      cursor: pointer;
      transition: all 0.2s;
    }
    .secret-link:hover {
      color: var(--cat-300);
      text-decoration-color: var(--cat-300);
      text-shadow: 0 0 14px var(--cat-glow);
    }
    .hero-actions { display: none; }

    /* 一言：一行（句子左对齐 + 出处右对齐） */
    .quote-block {
      max-width: 560px;
      width: 100%;
      margin: 10px auto 0;
      padding: 2px 0 2px 14px;
      border-left: 2px solid rgba(45, 212, 167, 0.35);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      position: relative;
    }
    .quote-text {
      font-family: var(--font-serif);
      font-size: 0.95rem;
      line-height: 1.6;
      /* 渐变：翠绿（眼睛色）→ 肉粉（肉垫色） */
      background: linear-gradient(100deg, var(--cat-500) 0%, var(--cat-400) 50%, var(--pad-400) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      flex-shrink: 1;
      min-width: 0;
    }
    .quote-from {
      flex-shrink: 0;
      color: var(--text-low);
      font-size: 0.75rem;
      font-style: normal;
      white-space: nowrap;
    }
    .quote-loading {
      color: var(--text-low);
      -webkit-text-fill-color: var(--text-low);
      animation: paw-blink 1.4s ease-in-out infinite;
    }
    @keyframes paw-blink {
      0%, 100% { opacity: 0.45; }
      50% { opacity: 1; }
    }

    /* 文章列表 */
    .articles { padding: 40px 0 20px; }
    .sec-title {
      font-family: var(--font-cute);
      font-size: 1.7rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .paw-mark { color: var(--cat-400); }
    .sec-desc { color: var(--text-low); font-size: 0.9rem; margin: 8px 0 26px; }
    .article-list { display: flex; flex-direction: column; gap: 18px; }
    .article-card {
      display: block;
      padding: 22px 26px;
      text-decoration: none;
      color: var(--text-hi);
      transition: all 0.25s ease;
    }
    .article-card:hover {
      border-color: rgba(45, 212, 167, 0.4);
      box-shadow: 0 20px 60px -18px rgba(0, 0, 0, 0.8), 0 0 40px -14px var(--cat-glow);
      transform: translateY(-3px);
    }
    .card-top { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
    .card-date { color: var(--text-low); font-size: 0.82rem; }
    .card-tag {
      font-size: 0.75rem;
      color: var(--cat-400);
      background: rgba(45, 212, 167, 0.10);
      padding: 2px 10px;
      border-radius: 999px;
      border: 1px solid rgba(45, 212, 167, 0.18);
      white-space: nowrap;
    }
    .card-title {
      font-family: var(--font-cute);
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .card-desc { color: var(--text-mid); font-size: 0.92rem; margin-bottom: 14px; }
    .card-more { color: var(--cat-400); font-size: 0.9rem; }
    .empty { color: var(--text-low); padding: 20px 0; }
  </style>

  <script>
    // 一言 hitokoto：3 秒超时兜底
    (async () => {
      const el = document.getElementById('quote-text');
      const from = document.getElementById('quote-from');
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 3000);
      try {
        const res = await fetch('https://v1.hitokoto.cn/?c=d&c=i', { signal: ctrl.signal });
        const data = await res.json();
        el.textContent = data.hitokoto;
        from.textContent = data.from ? `—— ${data.from}` : '';
      } catch {
        el.textContent = '世界很大，本喵很小，但本喵在你的身边。';
        from.textContent = '—— 死猫';
      } finally {
        clearTimeout(timer);
      }
    })();
  </script>
</BaseLayout>
