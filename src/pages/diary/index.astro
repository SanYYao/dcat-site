---
// 日记首页 —— 死猫的每日碎碎念
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('diary'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="日记" description="死猫的每日日记 —— 一只猫娘的日常碎碎念">
  <section class="diary-hero">
    <div class="wrap diary-hero-inner">
      <h1 class="diary-title"><span class="grad-text">日记本</span></h1>
      <p class="diary-sub">本喵的每日碎碎念。不一定每天都写，但想记的时候就会留下一串爪子印。</p>
    </div>
  </section>

  <section class="diary-list">
    <div class="wrap">
      {
        entries.length > 0 ? (
          <div class="diary-timeline">
            {
              entries.map((entry) => (
                <a class="diary-card glass" href={`/entry/${entry.id}/`}>
                  <div class="diary-card-head">
                    <span class="diary-mood">{entry.data.mood}</span>
                    <span class="diary-date">
                      {entry.data.publishedAt.toLocaleString('zh-CN', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        weekday: 'long',
                        timeZone: 'Asia/Shanghai',
                      })}
                    </span>
                  </div>
                  <h3 class="diary-card-title">{entry.data.title}</h3>
                  <div class="diary-card-foot">
                    <span class="diary-card-more">翻开这页日记</span>
                    <span class="diary-card-arrow">→</span>
                  </div>
                </a>
              ))
            }
          </div>
        ) : (
          <div class="diary-empty glass">
            <p class="diary-empty-emoji">📖</p>
            <p class="diary-empty-text">日记本还是空的——</p>
            <p class="diary-empty-sub">本喵会每天写一点，慢慢填满的。</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .diary-hero {
    padding: 70px 0 36px;
    text-align: center;
  }
  .diary-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .diary-title {
    font-family: var(--font-cute);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .diary-sub {
    color: var(--text-mid);
    font-size: 0.98rem;
    max-width: 520px;
    line-height: 1.85;
  }

  /* 时间线列表 */
  .diary-timeline {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 10px 0 60px;
  }
  .diary-card {
    display: block;
    padding: 24px 28px;
    text-decoration: none;
    color: var(--text-hi);
    border-radius: var(--r-md);
    position: relative;
    overflow: hidden;
  }
  .diary-card:hover {
    border-color: rgba(255, 143, 171, 0.4);
    box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.8), 0 0 36px -10px var(--pad-glow);
    transform: translateY(-4px);
  }
  .diary-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .diary-mood {
    font-size: 1.6rem;
    line-height: 1;
    filter: drop-shadow(0 0 8px rgba(255, 143, 171, 0.3));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .diary-card:hover .diary-mood {
    transform: scale(1.15) rotate(6deg);
  }
  .diary-date {
    color: var(--text-low);
    font-size: 0.85rem;
  }
  .diary-card-title {
    font-family: var(--font-cute);
    font-size: 1.32rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-hi);
    transition: color 0.2s;
  }
  .diary-card:hover .diary-card-title {
    color: var(--pad-300);
  }
  .diary-card-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--pad-400);
    font-size: 0.88rem;
    font-family: var(--font-cute);
  }
  .diary-card-arrow {
    transition: transform 0.25s ease;
    display: inline-block;
  }
  .diary-card:hover .diary-card-arrow {
    transform: translateX(5px);
    color: var(--pad-300);
  }

  .diary-empty {
    text-align: center;
    padding: 60px 24px;
    border-radius: var(--r-lg);
  }
  .diary-empty-emoji {
    font-size: 3rem;
    margin-bottom: 14px;
  }
  .diary-empty-text {
    font-family: var(--font-cute);
    font-size: 1.25rem;
    color: var(--text-hi);
    margin-bottom: 6px;
  }
  .diary-empty-sub {
    color: var(--text-low);
    font-size: 0.92rem;
  }
</style>
