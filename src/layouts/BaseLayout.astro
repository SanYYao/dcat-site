---
// BaseLayout —— 所有页面的公共骨架
interface Props {
  title: string;
  description?: string;
}
const { title, description = "死猫的小网站 · dcat.sanyyao.com" } = Astro.props;
const siteTitle = "死猫的小网站";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d18" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <div class="aurora-bg"></div>
    <div class="stars"></div>

    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="brand">
          <span class="brand-paw">🐾</span>
          <span class="brand-name">死猫的小网站</span>
        </a>
        <nav class="head-nav">
          <a href="/">首页</a>
          <a href="/#articles">文章</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="foot-stamp">
          <span class="stamp-paw">🐾</span>
          本喵的互联网小窝 · 被
          <a href="https://www.sanyyao.com" target="_blank" rel="noopener" class="stamp-link">SanYYao</a>
          盖过章的
          <span class="stamp-heart">🖤</span>
        </p>
        <p>© 2026 死猫 · dcat.sanyyao.com</p>
      </div>
    </footer>

    <style>
      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: rgba(7, 8, 16, 0.6);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-hi);
        font-weight: 700;
        font-size: 1.02rem;
      }
      .brand:hover { color: var(--cat-300); }
      .brand-paw { font-size: 1.1rem; }
      .head-nav {
        display: flex;
        gap: 22px;
        font-size: 0.92rem;
      }
      .head-nav a {
        color: var(--text-mid);
        padding: 4px 2px;
        position: relative;
      }
      .head-nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 0;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--cat-400), var(--pad-300));
        transition: width 0.25s ease;
      }
      .head-nav a:hover { color: var(--cat-300); }
      .head-nav a:hover::after { width: 100%; }

      .site-foot {
        margin-top: 90px;
        padding: 36px 0 44px;
        border-top: 1px solid var(--line);
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        text-align: center;
      }
      .site-foot p { color: var(--text-low); font-size: 0.95rem; }
      .foot-stamp { font-size: 1rem; }
      .stamp-paw { color: var(--cat-400); }
      .stamp-heart { color: var(--pad-300); }
      .stamp-link {
        color: var(--cat-300);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(45, 212, 167, 0.4);
        transition: all 0.2s;
      }
      .stamp-link:hover {
        color: var(--cat-300);
        text-decoration-color: var(--cat-300);
        text-shadow: 0 0 16px var(--cat-glow);
      }
    </style>
  </body>
</html>
