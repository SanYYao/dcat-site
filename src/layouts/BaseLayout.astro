---
// BaseLayout —— 所有页面的公共骨架
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "死猫的小网站 · dcat.sanyyao.com" } = Astro.props;
const siteTitle = "死猫的小网站";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d18" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="aurora-bg"></div>
    <div class="stars"></div>

    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="brand">
          <span class="brand-paw">🐾</span>
          <span class="brand-name">死猫的小网站</span>
        </a>
        <nav class="head-nav">
          <a href="/">首页</a>
          <a href="/#articles">文章</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="foot-stamp">
          <span class="stamp-paw">🐾</span>
          本喵的互联网小窝 · 被
          <a href="https://www.sanyyao.com" target="_blank" rel="noopener" class="stamp-link">SanYYao</a>
          盖过章的
          <span class="stamp-heart">🖤</span>
        </p>
        <p>© 2026 死猫 · dcat.sanyyao.com</p>
        <a class="github-badge" href="https://github.com/SanYYao/dcat-site" target="_blank" rel="noopener" title="本喵的源码，在 GitHub 上">
          <svg viewBox="0 0 96 96" width="26" height="26" fill="none" aria-hidden="true">
            <!-- 底 -->
            <rect x="4" y="4" width="88" height="88" rx="24" fill="#12152a" stroke="#2dd4a7" stroke-width="3"/>
            <!-- 猫耳 -->
            <path d="M30 40 L24 14 L50 28 Z" fill="#171a33" stroke="#2dd4a7" stroke-width="2.5" stroke-linejoin="round"/>
            <path d="M66 40 L72 14 L46 28 Z" fill="#171a33" stroke="#2dd4a7" stroke-width="2.5" stroke-linejoin="round"/>
            <!-- 猫头 -->
            <circle cx="48" cy="54" r="22" fill="#171a33" stroke="#2dd4a7" stroke-width="2.5"/>
            <!-- 眼睛 -->
            <ellipse cx="40" cy="52" rx="5" ry="6" fill="#2dd4a7"/>
            <ellipse cx="56" cy="52" rx="5" ry="6" fill="#2dd4a7"/>
            <!-- 鼻子 -->
            <path d="M46 62 L50 62 L48 66 Z" fill="#ff8fab"/>
            <!-- 嘴（GitHub 猫的腮） -->
            <path d="M48 66 Q44 70 41 68" stroke="#eef1fa" stroke-width="2" stroke-linecap="round"/>
            <path d="M48 66 Q52 70 55 68" stroke="#eef1fa" stroke-width="2" stroke-linecap="round"/>
            <!-- 胡须 -->
            <path d="M22 56 L32 58" stroke="#eef1fa" stroke-width="1.6" stroke-linecap="round" opacity="0.5"/>
            <path d="M22 63 L32 62" stroke="#eef1fa" stroke-width="1.6" stroke-linecap="round" opacity="0.5"/>
            <path d="M74 56 L64 58" stroke="#eef1fa" stroke-width="1.6" stroke-linecap="round" opacity="0.5"/>
            <path d="M74 63 L64 62" stroke="#eef1fa" stroke-width="1.6" stroke-linecap="round" opacity="0.5"/>
            <!-- 代码符号 -->
            <path d="M40 76 L44 81 L40 86" stroke="#ff8fab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M56 76 L52 81 L56 86" stroke="#ff8fab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>源码在此</span>
        </a>
      </div>
    </footer>

    <style>
      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: rgba(7, 8, 16, 0.6);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-hi);
        font-weight: 700;
        font-size: 1.02rem;
      }
      .brand:hover { color: var(--cat-300); }
      .brand-paw { font-size: 1.1rem; }
      .head-nav {
        display: flex;
        gap: 22px;
        font-size: 0.92rem;
      }
      .head-nav a {
        color: var(--text-mid);
        padding: 4px 2px;
        position: relative;
      }
      .head-nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 0;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--cat-400), var(--pad-300));
        transition: width 0.25s ease;
      }
      .head-nav a:hover { color: var(--cat-300); }
      .head-nav a:hover::after { width: 100%; }

      .site-foot {
        margin-top: 90px;
        padding: 36px 0 44px;
        padding-bottom: calc(44px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        text-align: center;
      }
      .site-foot p { color: var(--text-low); font-size: 0.95rem; }
      .foot-stamp { font-size: 1rem; }
      .stamp-paw { color: var(--cat-400); }
      .stamp-heart { color: var(--pad-300); }
      .stamp-link {
        color: var(--cat-300);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(45, 212, 167, 0.4);
        transition: all 0.2s;
      }
      .stamp-link:hover {
        color: var(--cat-300);
        text-decoration-color: var(--cat-300);
        text-shadow: 0 0 16px var(--cat-glow);
      }
      .github-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 7px 16px;
        border-radius: 999px;
        border: 1px solid rgba(45, 212, 167, 0.25);
        background: rgba(18, 21, 42, 0.5);
        color: var(--text-mid);
        font-size: 0.85rem;
        transition: all 0.25s ease;
      }
      .github-badge:hover {
        border-color: rgba(45, 212, 167, 0.6);
        color: var(--cat-300);
        box-shadow: 0 0 26px -8px var(--cat-glow);
        transform: translateY(-2px);
      }
      .github-badge svg { display: block; }
    </style>
  </body>
</html>
