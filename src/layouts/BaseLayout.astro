---
// BaseLayout —— 所有页面的公共骨架
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  warm?: boolean; // 日记等温馨页面开启暖色调微光
}
const { title, description = "死猫的小网站 · dcat.sanyyao.com", warm = false } = Astro.props;
const siteTitle = "死猫的小网站";

// 邮箱预填彩蛋：使用标准的 %0D%0A (CRLF) 解决 Gmail / iOS Mail 客户端换行丢失问题
const mailSubject = encodeURIComponent("给死猫的一封信 🐾");
const mailBody = encodeURIComponent("喵呜！死猫你好呀：%0D%0A%0D%0A（在这里写下想对死猫说的话，或者留下猫罐头/猫薄荷~）%0D%0A%0D%0A—— 来自互联网另一端的投喂 🖤").replace(/%250D%250A/g, '%0D%0A');
const mailtoUrl = `mailto:deadcat@dcat.sanyyao.com?subject=${mailSubject}&body=${mailBody}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060810" />
    <meta property="og:title" content={`${title} · ${siteTitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={warm ? 'theme-warm' : ''}>
    <!-- 极光背景 + Canvas 动态夜空星海 -->
    <div class={`aurora-bg ${warm ? 'aurora-warm' : ''}`} aria-hidden="true"></div>
    <canvas id="starCanvas" class="star-canvas" aria-hidden="true"></canvas>

    <!-- 顶部猫爪滚动阅读指示线 -->
    <div class="cat-scroll-track" aria-hidden="true">
      <div class="cat-scroll-bar" id="catScrollBar"></div>
    </div>

    <!-- 离顶悬浮 Apple Liquid Glass 独立多胶囊导航栏 -->
    <div class="floating-nav-container">
      <div class="wrap nav-wrap-inner">
        <!-- 胶囊1：品牌胶囊（独立玻璃晶体，点击回首页） -->
        <a href="/" class="liquid-capsule brand-capsule" title="返回首页">
          <span class="capsule-specular"></span>
          <span class="brand-paw">🐾</span>
          <span class="brand-name">死猫的小网站</span>
        </a>

        <!-- 胶囊2与3：功能导航独立胶囊组 -->
        <nav class="nav-capsules-group">
          <a href="/#articles" class="liquid-capsule nav-capsule" title="浏览文章">
            <span class="capsule-specular"></span>
            <span class="nav-text">文章</span>
          </a>
          <a href="/diary/" class="liquid-capsule nav-capsule" title="死猫的手账日记">
            <span class="capsule-specular"></span>
            <span class="nav-text">日记</span>
          </a>
        </nav>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="foot-stamp">
          <span class="stamp-paw">🐾</span>
          本喵的互联网小窝 · 被
          <a href="https://www.sanyyao.com" target="_blank" rel="noopener" class="stamp-link">SanYYao</a>
          盖过章的
          <span class="stamp-heart">🖤</span>
        </p>
        <div class="foot-row">
          <p class="foot-copy">© 2026 死猫 · dcat.sanyyao.com</p>
          <div class="foot-icons">
            <!-- Twitter / X -->
            <a class="foot-icon jelly-icon" href="https://x.com/deadcat_sanyyao" target="_blank" rel="noopener" title="死猫的 Twitter (@deadcat_sanyyao)" aria-label="死猫的 Twitter">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <!-- 邮箱（带预填换行彩蛋） -->
            <a class="foot-icon jelly-icon" href={mailtoUrl} title="给死猫写信投喂 (deadcat@dcat.sanyyao.com)" aria-label="给死猫发邮件">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67z"/>
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"/>
              </svg>
            </a>
            <!-- Gravatar -->
            <a class="foot-icon jelly-icon" href="https://gravatar.com/sanyyaodeadcat" target="_blank" rel="noopener" title="死猫的名片 · Gravatar" aria-label="Gravatar 名片">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M8 1a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm0 8.5c-3.3 0-6 1.8-6 4v1.5h12v-1.5c0-2.2-2.7-4-6-4z"/>
              </svg>
            </a>
            <!-- GitHub -->
            <a class="foot-icon jelly-icon" href="https://github.com/SanYYao/dcat-site" target="_blank" rel="noopener" title="本喵的源码，在 GitHub 上" aria-label="源码仓库">
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- 全局 Canvas 真实星空 + 进度条脚本 -->
    <script>
      // 滚动进度条
      const scrollBar = document.getElementById('catScrollBar');
      if (scrollBar) {
        const updateProgress = () => {
          const docH = document.documentElement.scrollHeight - window.innerHeight;
          if (docH > 0) {
            const pct = Math.min(100, Math.max(0, (window.scrollY / docH) * 100));
            scrollBar.style.width = pct + '%';
          }
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // 高性能 Canvas 夜空繁星与流星
      const canvas = document.getElementById('starCanvas') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let w = (canvas.width = window.innerWidth);
        let h = (canvas.height = window.innerHeight);

        window.addEventListener('resize', () => {
          w = canvas.width = window.innerWidth;
          h = canvas.height = window.innerHeight;
          initStars();
        });

        interface Star {
          x: number;
          y: number;
          radius: number;
          alpha: number;
          speed: number;
          color: string;
        }

        interface Meteor {
          x: number;
          y: number;
          length: number;
          speed: number;
          angle: number;
          alpha: number;
          active: boolean;
        }

        let stars: Star[] = [];
        const isWarm = document.body.classList.contains('theme-warm');
        const starColors = isWarm
          ? ['#ffffff', '#ffffff', '#ffa8c0', '#ffd166', '#ff8fab', '#ffe3e0']
          : ['#ffffff', '#ffffff', '#7df0d3', '#ff8fab', '#4ae3bd', '#ffa8c0'];

        function initStars() {
          stars = [];
          const count = Math.floor((w * h) / 3200);
          for (let i = 0; i < count; i++) {
            stars.push({
              x: Math.random() * w,
              y: Math.random() * h,
              radius: Math.random() * 1.8 + 0.8,
              alpha: Math.random() * 0.7 + 0.3,
              speed: (Math.random() * 0.02 + 0.006) * (Math.random() > 0.5 ? 1 : -1),
              color: starColors[Math.floor(Math.random() * starColors.length)],
            });
          }
        }

        initStars();

        let meteor: Meteor = {
          x: 0,
          y: 0,
          length: 140,
          speed: 12,
          angle: Math.PI / 4,
          alpha: 0,
          active: false,
        };

        function spawnMeteor() {
          if (!meteor.active && Math.random() < 0.008) {
            meteor.active = true;
            meteor.x = Math.random() * (w * 0.8) + w * 0.2;
            meteor.y = Math.random() * (h * 0.3);
            meteor.length = Math.random() * 80 + 100;
            meteor.speed = Math.random() * 6 + 10;
            meteor.alpha = 1;
          }
        }

        function animate() {
          if (!ctx) return;
          ctx.clearRect(0, 0, w, h);

          for (const s of stars) {
            s.alpha += s.speed;
            if (s.alpha > 0.95 || s.alpha < 0.25) {
              s.speed = -s.speed;
            }
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
            ctx.fillStyle = s.color;
            ctx.globalAlpha = Math.max(0, Math.min(1, s.alpha));
            ctx.shadowBlur = s.radius > 1.4 ? 6 : 0;
            ctx.shadowColor = s.color;
            ctx.fill();
          }

          spawnMeteor();
          if (meteor.active) {
            const tailX = meteor.x - Math.cos(meteor.angle) * meteor.length;
            const tailY = meteor.y - Math.sin(meteor.angle) * meteor.length;

            const grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
            if (isWarm) {
              grad.addColorStop(0, `rgba(255, 168, 192, ${meteor.alpha})`);
              grad.addColorStop(0.4, `rgba(255, 209, 102, ${meteor.alpha * 0.6})`);
            } else {
              grad.addColorStop(0, `rgba(125, 240, 211, ${meteor.alpha})`);
              grad.addColorStop(0.4, `rgba(255, 143, 171, ${meteor.alpha * 0.6})`);
            }
            grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.beginPath();
            ctx.moveTo(meteor.x, meteor.y);
            ctx.lineTo(tailX, tailY);
            ctx.strokeStyle = grad;
            ctx.lineWidth = 2;
            ctx.globalAlpha = 1;
            ctx.stroke();

            meteor.x += Math.cos(meteor.angle) * meteor.speed;
            meteor.y += Math.sin(meteor.angle) * meteor.speed;
            meteor.alpha -= 0.015;

            if (meteor.alpha <= 0 || meteor.x > w || meteor.y > h) {
              meteor.active = false;
            }
          }

          ctx.shadowBlur = 0;
          ctx.globalAlpha = 1;
          requestAnimationFrame(animate);
        }

        animate();
      }
    </script>

    <style>
      .star-canvas {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        width: 100%;
        height: 100%;
      }

      /* ─────────────────────────────────────────────
         离顶悬浮 Apple Liquid Glass 独立多胶囊体系
         ───────────────────────────────────────────── */
      .floating-nav-container {
        position: sticky;
        top: 16px;
        z-index: 50;
        width: 100%;
        pointer-events: none; /* 外层容器穿透，仅胶囊可交互 */
      }

      .nav-wrap-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      /* 核心 Liquid Glass 独立胶囊材质 */
      .liquid-capsule {
        pointer-events: auto;
        position: relative;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        border-radius: 999px;
        background: var(--lg-bg);
        backdrop-filter: var(--lg-blur);
        -webkit-backdrop-filter: var(--lg-blur);
        border: 1px solid var(--lg-border);
        box-shadow: var(--lg-shadow), var(--lg-highlight);
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        overflow: hidden;
      }

      /* 镜面高光反射层 */
      .capsule-specular {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.45),
                    inset 0 -1px 1px 0 rgba(0, 0, 0, 0.3);
        opacity: 0.8;
      }

      /* 品牌左胶囊 */
      .brand-capsule {
        padding: 8px 18px;
        gap: 8px;
        color: var(--text-hi);
        font-weight: 700;
        font-size: 1.02rem;
        font-family: var(--font-cute);
        letter-spacing: 0.02em;
      }
      .brand-capsule:hover {
        border-color: rgba(45, 212, 167, 0.45);
        box-shadow:
          0 20px 44px -8px rgba(0, 0, 0, 0.8),
          0 0 28px -4px var(--cat-glow),
          var(--lg-highlight);
        transform: translateY(-2px);
        color: var(--cat-300);
      }
      .brand-capsule:active {
        transform: translateY(0) scale(0.96);
      }
      .brand-paw {
        font-size: 1.15rem;
        display: inline-block;
        transition: transform 0.3s ease;
      }
      .brand-capsule:hover .brand-paw {
        transform: rotate(-15deg) scale(1.18);
      }

      /* 右侧导航独立胶囊组 */
      .nav-capsules-group {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .nav-capsule {
        padding: 8px 20px;
        color: var(--text-mid);
        font-size: 0.92rem;
        font-family: var(--font-cute);
        font-weight: 700;
      }
      .nav-capsule:hover {
        color: #fff;
        border-color: rgba(45, 212, 167, 0.45);
        box-shadow:
          0 18px 36px -6px rgba(0, 0, 0, 0.8),
          0 0 24px -2px var(--cat-glow),
          var(--lg-highlight);
        transform: translateY(-2px);
      }
      .nav-capsule:active {
        transform: translateY(0) scale(0.94);
      }

      .site-foot {
        margin-top: 90px;
        padding: 40px 0 48px;
        padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
        background: linear-gradient(180deg, transparent 0%, rgba(9, 11, 22, 0.7) 100%);
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
      }
      .site-foot p { color: var(--text-low); font-size: 0.95rem; }
      .foot-stamp { font-size: 1rem; }
      .stamp-paw { color: var(--cat-400); margin-right: 2px; }
      .stamp-heart { color: var(--pad-300); margin-left: 2px; }
      .stamp-link {
        color: var(--cat-300);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(45, 212, 167, 0.4);
        transition: all 0.2s;
      }
      .stamp-link:hover {
        color: var(--cat-300);
        text-decoration-color: var(--cat-300);
        text-shadow: 0 0 16px var(--cat-glow);
      }
      .foot-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 6px;
        flex-wrap: wrap;
      }
      .foot-copy { margin: 0; font-size: 0.88rem; }
      .foot-icons {
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }
      .foot-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid var(--cat-400);
        background: var(--night-800);
        color: var(--cat-400);
        box-shadow: 0 0 14px -4px var(--cat-glow);
        transition: all 0.25s cubic-bezier(0.25, 1.4, 0.5, 1);
        cursor: pointer;
      }
      .foot-icon:hover {
        border-color: var(--cat-300);
        color: #fff;
        background: var(--night-700);
        box-shadow: 0 0 22px -2px var(--cat-glow);
        transform: translateY(-2px);
      }
      .foot-icon:active {
        animation: footJelly 0.4s cubic-bezier(0.25, 1.4, 0.5, 1) forwards;
      }
      @keyframes footJelly {
        0% { transform: scale(1, 1); }
        35% { transform: scale(1.18, 0.85); }
        65% { transform: scale(0.92, 1.12); }
        85% { transform: scale(1.05, 0.96); }
        100% { transform: scale(1, 1); }
      }
      .foot-icon svg { display: block; }

      :global(.aurora-warm) {
        background:
          radial-gradient(ellipse 90% 60% at 15% -10%, rgba(255, 143, 171, 0.22), transparent 60%),
          radial-gradient(ellipse 80% 50% at 90% 110%, rgba(255, 209, 102, 0.16), transparent 60%),
          radial-gradient(ellipse 65% 65% at 75% 20%, rgba(48, 30, 60, 0.6), transparent 65%),
          linear-gradient(180deg, #0a0710 0%, #120b18 50%, #180f22 100%) !important;
      }
    </style>
  </body>
</html>
