---
// BaseLayout —— 所有页面的公共骨架
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  warm?: boolean;
}
const { title, description = "死猫的小网站 · dcat.sanyyao.com", warm = false } = Astro.props;
const siteTitle = "死猫的小网站";

const mailSubject = encodeURIComponent("给死猫的一封信 🐾");
const mailBody = encodeURIComponent("喵呜！死猫你好呀：%0D%0A%0D%0A（在这里写下想对死猫说的话，或者留下猫罐头/猫薄荷~）%0D%0A%0D%0A—— 来自互联网另一端的投喂 🖤").replace(/%250D%250A/g, '%0D%0A');
const mailtoUrl = `mailto:deadcat@dcat.sanyyao.com?subject=${mailSubject}&body=${mailBody}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060810" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:title" content={`${title} · ${siteTitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={warm ? 'theme-warm' : ''}>
    <!-- Apple Liquid Glass 真实光学折射滤镜引擎 (SVG feDisplacementMap) -->
    <svg width="0" height="0" style="position: absolute; pointer-events: none;" aria-hidden="true">
      <defs>
        <filter id="liquid-glass-refraction" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="92" result="noise" />
          <feGaussianBlur in="noise" stdDeviation="2.5" result="blurred" />
          <feDisplacementMap in="SourceGraphic" in2="blurred" scale="40" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- 极光背景 + Canvas 动态夜空星海（全屏顶格覆盖） -->
    <div class={`aurora-bg ${warm ? 'aurora-warm' : ''}`} aria-hidden="true"></div>
    <canvas id="starCanvas" class="star-canvas" aria-hidden="true"></canvas>

    <!-- 顶部猫爪滚动阅读指示线 -->
    <div class="cat-scroll-track" aria-hidden="true">
      <div class="cat-scroll-bar" id="catScrollBar"></div>
    </div>

    <!-- 离顶悬浮智能弹出/隐藏 Apple Liquid Glass 独立多胶囊导航栏（慢速从容缓动） -->
    <div class="floating-nav-container" id="floatingNav">
      <div class="wrap nav-wrap-inner">
        <!-- 胶囊1：品牌独立液体玻璃晶体（点击回首页 + 软果冻触感） -->
        <a href="/" class="liquid-capsule brand-capsule pudding-touch" title="返回首页">
          <div class="glass-shine"></div>
          <span class="brand-paw">🐾</span>
          <span class="brand-name">死猫的小网站</span>
        </a>

        <!-- 胶囊2与3：功能导航独立液体玻璃晶体组 -->
        <nav class="nav-capsules-group">
          <a href="/#articles" class="liquid-capsule nav-capsule pudding-touch" title="浏览文章">
            <div class="glass-shine"></div>
            <span class="nav-text">文章</span>
          </a>
          <a href="/diary/" class="liquid-capsule nav-capsule pudding-touch" title="死猫的手账日记">
            <div class="glass-shine"></div>
            <span class="nav-text">日记</span>
          </a>
        </nav>
      </div>
    </div>

    <!-- 全屏切页 Loader（三阶段动画：入场/循环/出场，transition:persist 跨页存活） -->
    <div id="page-loader" class="page-loader" aria-hidden="true" role="status" aria-live="polite" transition:persist>
      <div class="loader-stage">
        <!-- 猫爪轮廓脉冲圈（非圆形几何形，贴合主题） -->
        <svg class="pulse-paw" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="50" cy="66" rx="23" ry="19"/>
          <ellipse cx="21" cy="37" rx="10" ry="12.5"/>
          <ellipse cx="40" cy="19" rx="9.5" ry="12.5"/>
          <ellipse cx="62" cy="19" rx="9.5" ry="12.5"/>
          <ellipse cx="80" cy="37" rx="10" ry="12.5"/>
        </svg>
        <!-- 猫爪图标 + 粉色肉垫 -->
        <svg class="paw-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <ellipse cx="50" cy="66" rx="23" ry="19"/>
          <ellipse cx="21" cy="37" rx="10" ry="12.5"/>
          <ellipse cx="40" cy="19" rx="9.5" ry="12.5"/>
          <ellipse cx="62" cy="19" rx="9.5" ry="12.5"/>
          <ellipse cx="80" cy="37" rx="10" ry="12.5"/>
          <!-- 粉色肉垫（掌垫）：心形，居中坐在掌部椭圆 (50,66) 上，视觉重心对齐 -->
          <path d="M44 76.5c-6.5-5.8-12-10-12-16 0-5.4 4.2-9.6 9.4-9.6 3.6 0 6.6 1.8 8.6 4.2 2-2.4 5-4.2 8.6-4.2 5.2 0 9.4 4.2 9.4 9.6 0 6-5.5 10.2-12 16z" fill="var(--pad-400)"/>
        </svg>
      </div>
      <p class="loader-text">喵生检测中…</p>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="foot-stamp">
          <span class="stamp-paw">🐾</span>
          本喵的互联网小窝 · 被
          <a href="https://www.sanyyao.com" target="_blank" rel="noopener" class="stamp-link">SanYYao</a>
          盖过章的
          <span class="stamp-heart">🖤</span>
        </p>
        <div class="foot-row">
          <p class="foot-copy">© 2026 死猫 · dcat.sanyyao.com</p>
          <div class="foot-icons">
            <!-- Twitter / X -->
            <a class="foot-icon pudding-touch" href="https://x.com/deadcat_sanyyao" target="_blank" rel="noopener" title="死猫的 Twitter (@deadcat_sanyyao)" aria-label="死猫的 Twitter">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <!-- 邮箱（带预填换行彩蛋） -->
            <a class="foot-icon pudding-touch" href={mailtoUrl} title="给死猫写信投喂 (deadcat@dcat.sanyyao.com)" aria-label="给死猫发邮件">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67z"/>
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"/>
              </svg>
            </a>
            <!-- Gravatar -->
            <a class="foot-icon pudding-touch" href="https://gravatar.com/sanyyaodeadcat" target="_blank" rel="noopener" title="死猫的名片 · Gravatar" aria-label="Gravatar 名片">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M8 1a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm0 8.5c-3.3 0-6 1.8-6 4v1.5h12v-1.5c0-2.2-2.7-4-6-4z"/>
              </svg>
            </a>
            <!-- GitHub -->
            <a class="foot-icon pudding-touch" href="https://github.com/SanYYao/dcat-site" target="_blank" rel="noopener" title="本喵的源码，在 GitHub 上" aria-label="源码仓库">
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

        <!-- 全局脚本：星空 Canvas / 滚动显隐导航 / 果冻弹簧 / 切页 Loader
         SPA 切页后 body DOM 会被 ClientRouter 整体替换——若只初始化一次，
         星空/弹簧会绑到已脱离页面的旧元素（星星消失 bug 的根因）。
         因此全部初始化收进 reinitPageFx()，由 astro:page-load（首载 + 每次切页）驱动。 -->
    <script>
      // ── 星空 Canvas：可反复重建（切页后新 canvas 接管，旧循环用 token 停掉）──
      let starAnimToken = 0;

      function startStarfield() {
        const canvas = document.getElementById('starCanvas') as HTMLCanvasElement;
        const token = ++starAnimToken;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        // DPR 适配：retina 上限制最高 2x，避免 3x 像素导致每帧绘制量爆炸
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        let w = window.innerWidth;
        let h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx?.scale(dpr, dpr);

        interface Star { x: number; y: number; radius: number; alpha: number; speed: number; color: string; }
        interface Meteor { x: number; y: number; length: number; speed: number; angle: number; alpha: number; active: boolean; }

        let stars: Star[] = [];
        const isWarm = document.body.classList.contains('theme-warm');
        const starColors = isWarm
          ? ['#ffffff', '#ffffff', '#ffa8c0', '#ffd166', '#ff8fab', '#ffe3e0']
          : ['#ffffff', '#ffffff', '#7df0d3', '#ff8fab', '#4ae3bd', '#ffa8c0'];

        function initStars() {
          stars = [];
          // 密度降低（/4500），减少每帧绘制量；移动端进一步减半
          const isMobile = Math.min(w, h) < 768;
          const count = Math.floor((w * h) / (isMobile ? 9000 : 4500));
          for (let i = 0; i < count; i++) {
            stars.push({
              x: Math.random() * w,
              y: Math.random() * h,
              radius: Math.random() * 1.4 + 0.5,
              alpha: Math.random() * 0.6 + 0.3,
              speed: (Math.random() * 0.018 + 0.005) * (Math.random() > 0.5 ? 1 : -1),
              color: starColors[Math.floor(Math.random() * starColors.length)],
            });
          }
        }
        initStars();

        let meteor: Meteor = { x: 0, y: 0, length: 140, speed: 12, angle: Math.PI / 4, alpha: 0, active: false };

        function spawnMeteor() {
          if (!meteor.active && Math.random() < 0.008) {
            meteor.active = true;
            meteor.x = Math.random() * (w * 0.8) + w * 0.2;
            meteor.y = Math.random() * (h * 0.3);
            meteor.length = Math.random() * 80 + 100;
            meteor.speed = Math.random() * 6 + 10;
            meteor.alpha = 1;
          }
        }

        function animate() {
          // token 不一致或被替换/脱离 DOM → 停掉旧循环（省电 + 不画到脱离页面的画布）
          if (starAnimToken !== token || !canvas.isConnected) return;
          if (!ctx) return;
          ctx.clearRect(0, 0, w, h);

          for (const s of stars) {
            s.alpha += s.speed;
            if (s.alpha > 0.95 || s.alpha < 0.25) s.speed = -s.speed;
            // 大星星用预渲染 radial-gradient 光晕（不每帧 blur，性能友好）
            if (s.radius > 1.2) {
              const glow = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.radius * 3);
              glow.addColorStop(0, s.color);
              glow.addColorStop(0.35, s.color);
              glow.addColorStop(1, 'rgba(0,0,0,0)');
              ctx.fillStyle = glow;
              ctx.globalAlpha = Math.max(0, Math.min(1, s.alpha)) * 0.4;
              ctx.beginPath();
              ctx.arc(s.x, s.y, s.radius * 3, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
            ctx.fillStyle = s.color;
            ctx.globalAlpha = Math.max(0, Math.min(1, s.alpha));
            ctx.fill();
          }

          spawnMeteor();
          if (meteor.active) {
            const tailX = meteor.x - Math.cos(meteor.angle) * meteor.length;
            const tailY = meteor.y - Math.sin(meteor.angle) * meteor.length;
            const grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
            if (isWarm) {
              grad.addColorStop(0, `rgba(255, 168, 192, ${meteor.alpha})`);
              grad.addColorStop(0.4, `rgba(255, 209, 102, ${meteor.alpha * 0.6})`);
            } else {
              grad.addColorStop(0, `rgba(125, 240, 211, ${meteor.alpha})`);
              grad.addColorStop(0.4, `rgba(255, 143, 171, ${meteor.alpha * 0.6})`);
            }
            grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
            ctx.beginPath();
            ctx.moveTo(meteor.x, meteor.y);
            ctx.lineTo(tailX, tailY);
            ctx.strokeStyle = grad;
            ctx.lineWidth = 2;
            ctx.globalAlpha = 1;
            ctx.stroke();
            meteor.x += Math.cos(meteor.angle) * meteor.speed;
            meteor.y += Math.sin(meteor.angle) * meteor.speed;
            meteor.alpha -= 0.015;
            if (meteor.alpha <= 0 || meteor.x > w || meteor.y > h) meteor.active = false;
          }

          ctx.shadowBlur = 0;
          ctx.globalAlpha = 1;
          requestAnimationFrame(animate);
        }
        animate();

        // resize 只属于当前实例：旧实例被新实例接管后，其 resize 由 token 屏蔽
        const onResize = () => {
          if (starAnimToken !== token) return;
          const cw = window.innerWidth, ch = window.innerHeight;
          canvas.width = cw * dpr; canvas.height = ch * dpr;
          ctx?.scale(dpr, dpr);
          w = cw; h = ch; initStars();
        };
        window.addEventListener('resize', onResize);
      }

      // ── 滚动进度条 + 悬浮胶囊显隐 ──
      // 切页后 scrollBar/navEl 换成新 DOM 节点，每次 reinit 重新抓取；监听只挂一次
      let scrollBar: HTMLElement | null = null;
      let navEl: HTMLElement | null = null;
      let lastScrollY = 0;
      let ticking = false;

      function handleScroll() {
        const currentY = window.scrollY;
        const docH = document.documentElement.scrollHeight - window.innerHeight;
        // 元素可能被切页替换，兜底重查
        if (!scrollBar || !scrollBar.isConnected) scrollBar = document.getElementById('catScrollBar');
        if (!navEl || !navEl.isConnected) navEl = document.getElementById('floatingNav');
        if (scrollBar && docH > 0) {
          const pct = Math.min(100, Math.max(0, (currentY / docH) * 100));
          scrollBar.style.width = pct + '%';
        }
        if (navEl) {
          if (currentY > 80 && currentY > lastScrollY + 8) navEl.classList.add('nav-hidden');
          else if (currentY < lastScrollY - 6 || currentY <= 20) navEl.classList.remove('nav-hidden');
        }
        lastScrollY = currentY <= 0 ? 0 : currentY;
        ticking = false;
      }

      function bindScroll() {
        scrollBar = document.getElementById('catScrollBar');
        navEl = document.getElementById('floatingNav');
        lastScrollY = window.scrollY;
        if ((window as any).__scrollBound) return;
        (window as any).__scrollBound = true;
        window.addEventListener('scroll', () => {
          if (!ticking) { window.requestAnimationFrame(handleScroll); ticking = true; }
        }, { passive: true });
      }

      // ── 通用果冻物理弹簧（.pudding-touch）──
      // 与头像同参数（k=22.9, c=7.67, 点击 v0=-1.1, 1.2s 收敛，短行程）
      function bindSprings() {
        document.querySelectorAll('.pudding-touch').forEach((el) => {
          if ((el as HTMLElement).dataset.springBound) return;
          (el as HTMLElement).dataset.springBound = '1';
          const spring = { scale: 1, vel: 0 };
          let lastTime = 0;
          let rafId: number | null = null;
          const tick = (now: number) => {
            const dt = Math.min((now - lastTime) / 1000, 1 / 30);
            lastTime = now;
            const force = -22.9 * (spring.scale - 1) - 7.67 * spring.vel;
            spring.vel += force * dt;
            spring.scale += spring.vel * dt;
            (el as HTMLElement).style.transform = `scale(${spring.scale.toFixed(4)})`;
            if (Math.abs(spring.scale - 1) < 0.0005 && Math.abs(spring.vel) < 0.0005) {
              (el as HTMLElement).style.transform = '';
              rafId = null;
              return;
            }
            rafId = requestAnimationFrame(tick);
          };
          el.addEventListener('pointerdown', () => {
            spring.vel = -1.1;
            if (rafId === null) { lastTime = performance.now(); rafId = requestAnimationFrame(tick); }
          });
        });
      }

      // ── 全屏切页 Loader：三阶段动画状态机（入场/循环/出场）──
      // 高斯模糊秒出 → 0.2s 后 → 脉冲圈贝塞尔展开 → 猫爪带肉垫缩放出现
      // → 循环呼吸（加载慢兜底）→ 出场（猫爪放大→缩小 + 脉冲冲出屏幕）
      // ⚠️ 所有阶段用「当前 scale 作为起点」插值到目标值，不写死数值——
      //    循环任意缩放点被快进到出场都能平滑衔接，不跳变。
      // 由 ClientRouter 生命周期事件驱动（document 级 + loader persist，只绑一次）
      function bindLoader() {
        const pageLoader = document.getElementById('page-loader');
        if (!pageLoader || (window as any).__loaderBound) return;
        (window as any).__loaderBound = true;

        const pulseEl = pageLoader.querySelector('.pulse-paw') as HTMLElement;
        const pawEl = pageLoader.querySelector('.paw-icon') as HTMLElement;
        if (!pulseEl || !pawEl) return;

        // 缓动函数（贝塞尔近似）
        const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
        const easeOutBack = (t: number) => { const c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2); };
        const easeInCubic = (t: number) => t * t * t;

        // 当前缩放值（状态机插值的锚点）
        let pulseScale = 0;
        let pawScale = 0;
        let rafId: number | null = null;
        let loopPhase = 'idle'; // idle | entrance | loop | exit
        let loopT = 0;          // 循环呼吸相位
        let exitDone: (() => void) | null = null;

        // 应用 transform
        function applyScales() {
          pulseEl.style.transform = `scale(${pulseScale.toFixed(4)})`;
          pawEl.style.transform = `scale(${pawScale.toFixed(4)})`;
        }

        // 核心：rAF 驱动一条「从当前值插值到目标值」的补间
        // 每个阶段 start() 时记录起点（当前值），目标 + 时长 + 缓动 → 平滑过渡
        let fromPulse = 0, fromPaw = 0, toPulse = 0, toPaw = 0;
        let tweenStart = 0, tweenDur = 0;
        let tweenEase: (t: number) => number = easeOutCubic;
        let tweenOnDone: (() => void) | null = null;

        function startTween(pT: number, wT: number, durMs: number, ease: (t: number) => number, onDone?: () => void) {
          fromPulse = pulseScale; fromPaw = pawScale;
          toPulse = pT; toPaw = wT;
          tweenStart = performance.now();
          tweenDur = durMs;
          tweenEase = ease;
          tweenOnDone = onDone || null;
          // 关键修复：先停掉可能还占着 rafId 的循环 rAF，再启动补间，
          // 否则出场/入场的补间会因为 rafId 非 null 而根本不启动（第二段卡住的根因）
          if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
          rafId = requestAnimationFrame(tick);
        }

        function tick(now: number) {
          const t = Math.min(1, (now - tweenStart) / tweenDur);
          const e = tweenEase(t);
          pulseScale = fromPulse + (toPulse - fromPulse) * e;
          pawScale = fromPaw + (toPaw - fromPaw) * e;
          applyScales();

          if (t < 1) {
            rafId = requestAnimationFrame(tick);
          } else {
            rafId = null;
            if (tweenOnDone) { const fn = tweenOnDone; tweenOnDone = null; fn(); }
          }
        }

        // ── 入场：脉冲圈 0→1，到位后猫爪 0→1 ──
        function playEntrance() {
          loopPhase = 'entrance';
          // 阶段1a：脉冲圈从中心贝塞尔展开
          startTween(1, 0, 420, easeOutCubic, () => {
            // 阶段1b：猫爪跟随出现（轻微过冲）
            startTween(1.15, 1, 380, easeOutBack, () => {
              // 进入循环
              loopPhase = 'loop';
              loopT = 0;
              rafId = requestAnimationFrame(loopTick);
            });
          });
        }

        // ── 循环：猫爪呼吸 + 脉冲圈比入场大一圈（1.15 常驻）──
        function loopTick(now: number) {
          if (loopPhase !== 'loop') {
            // 离开循环阶段：清掉 rafId，让 startTween 能接手
            rafId = null;
            return;
          }
          // 呼吸相位：猫爪 0.9↔1.08 正弦，周期约 1.2s；脉冲圈 1.15 微呼吸
          loopT += 16 / 1000;
          pawScale = 0.99 + Math.sin(loopT * Math.PI * 1.6) * 0.09;
          pulseScale = 1.15 + Math.sin(loopT * Math.PI * 1.6) * 0.05;
          applyScales();
          rafId = requestAnimationFrame(loopTick);
        }

        // ── 出场：猫爪放大(0.15s)→缩小(0.2s) + 脉冲冲出屏幕 ──
        function playExit(onDone: () => void) {
          // 循环可能在任何 scale 被快进——从当前值插值，不跳变
          loopPhase = 'exit';
          exitDone = onDone;
          // 阶段3a：猫爪放大（比循环最大略大），脉冲开始外扩
          startTween(1.3, 1.25, 150, easeOutCubic, () => {
            // 阶段3b：猫爪快速缩小 + 脉冲猛扩冲出屏幕
            startTween(3.5, 0.4, 200, easeInCubic, () => {
              if (exitDone) { const fn = exitDone; exitDone = null; fn(); }
            });
          });
        }

        // ── 对外：显示（高斯模糊秒出 + 入场动画）──
        function showLoader() {
          // 模糊 + 盖层秒出（不进动画，遮 WebKit 切换）
          pageLoader.classList.add('active');
          pageLoader.setAttribute('aria-hidden', 'false');
          // 重置
          pulseScale = 0; pawScale = 0; applyScales();
          // 0.2s 后开始入场动画（先让模糊盖住，再启动内部动画）
          setTimeout(() => {
            if (loopPhase === 'idle' || loopPhase === 'exit') playEntrance();
          }, 200);
        }

        // ── 对外：隐藏（出场动画后淡出）──
        function hideLoader() {
          playExit(() => {
            pageLoader.classList.remove('active');
            pageLoader.setAttribute('aria-hidden', 'true');
            loopPhase = 'idle';
            pulseScale = 0; pawScale = 0; applyScales();
          });
        }

        // ── ClientRouter 事件 ──
        let showStart = 0;
        let hideTimer: number | null = null;
        const LOADER_MIN_MS = 2400; // 至少展示满一个呼吸周期，让动画可被看见

        document.addEventListener('astro:before-preparation', (e) => {
          // 站内锚点（同 URL 带 #hash）不是真正的切页，不弹 Loader
          const from = (e as any)?.from?.href || location.href;
          const to = (e as any)?.to?.href || '';
          const sameDoc = to.replace(/#.*$/, '') === from.replace(/#.*$/, '');
          if (sameDoc) return;
          showStart = Date.now();
          if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
          showLoader();
        });

        // 兜底保险：即使 page-load 没触发（异常），超时强制隐藏
        const MAX_SHOW_MS = 5000;
        document.addEventListener('astro:before-preparation', () => {
          if (hideTimer) { clearTimeout(hideTimer); }
          hideTimer = window.setTimeout(() => {
            if (loopPhase !== 'idle') hideLoader();
          }, MAX_SHOW_MS);
        });

        document.addEventListener('astro:page-load', () => {
          const elapsed = Date.now() - showStart;
          const wait = Math.max(0, LOADER_MIN_MS - elapsed);
          if (hideTimer) { clearTimeout(hideTimer); }
          hideTimer = window.setTimeout(() => {
            if (loopPhase !== 'idle') hideLoader();
          }, wait);
        });
      }

      // ── 首次加载 + 每次 SPA 切页后统一重建页面特效 ──
      // 各函数内部都有幂等守卫（token / 标记位），重复调用无害
      function reinitPageFx() {
        bindScroll();
        startStarfield();
        bindSprings();
        bindLoader();
      }

      document.addEventListener('astro:page-load', reinitPageFx);
      reinitPageFx();
    </script>

    <style>
      .star-canvas {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
      }

      /* ─────────────────────────────────────────────
         离顶悬浮 Apple Liquid Glass 独立多胶囊体系
         慢速从容缓动 (0.85s 极柔和缓动)
         ───────────────────────────────────────────── */
      .floating-nav-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding-top: calc(14px + env(safe-area-inset-top, 0px));
        z-index: 50;
        width: 100%;
        pointer-events: none;
        transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.65s ease;
        will-change: transform, opacity;
      }

      /* 智能向下滚动时：平滑向上优雅移出视野 */
      .floating-nav-container.nav-hidden {
        transform: translate3d(0, -120%, 0) scale(0.92);
        opacity: 0;
      }

      .nav-wrap-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      /* 核心独立胶囊材质：半透厚润深色暗晶体（性能优化版）
         去掉了 iOS 不支持的 SVG url() backdrop-filter 与 blur(16px) 重采样，
         改轻量半透明 + GPU 合成层，滚动不掉帧 */
      .liquid-capsule {
        pointer-events: auto;
        position: relative;
        isolation: isolate;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(22, 28, 56, 0.82), rgba(13, 17, 36, 0.72));
        backdrop-filter: blur(4px) saturate(140%);
        -webkit-backdrop-filter: blur(4px) saturate(140%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7),
                    inset 0 1px 0 rgba(255, 255, 255, 0.25),
                    inset 0 -1px 0 rgba(0, 0, 0, 0.3);
        /* GPU 合成层：transform 动画只走合成 */
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                    border-color 0.3s ease;
      }

      /* 镜面微光切边：纯 box-shadow，无动画 */
      .glass-shine {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        z-index: -1;
        pointer-events: none;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.35),
          inset 0 -1px 0 rgba(0, 0, 0, 0.25),
          inset 0 0 12px rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* 品牌左胶囊 */
      .brand-capsule {
        padding: 8px 18px;
        gap: 8px;
        color: var(--text-hi);
        font-weight: 700;
        font-size: 1.02rem;
        font-family: var(--font-cute);
        letter-spacing: 0.02em;
      }
      .brand-capsule:hover {
        transform: translateY(-2px);
        color: var(--cat-300);
      }
      .brand-capsule:hover .glass-shine {
        border-color: rgba(45, 212, 167, 0.4);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.6),
          0 0 20px -2px var(--cat-glow);
      }
      .brand-paw {
        font-size: 1.15rem;
        display: inline-block;
        transition: transform 0.3s ease;
      }
      .brand-capsule:hover .brand-paw {
        transform: rotate(-15deg) scale(1.15);
      }

      /* 右侧导航独立胶囊组 */
      .nav-capsules-group {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .nav-capsule {
        padding: 8px 20px;
        color: var(--text-mid);
        font-size: 0.92rem;
        font-family: var(--font-cute);
        font-weight: 700;
      }
      .nav-capsule:hover {
        color: #fff;
        transform: translateY(-2px);
      }
      .nav-capsule:hover .glass-shine {
        border-color: rgba(45, 212, 167, 0.4);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.6),
          0 0 18px -2px var(--cat-glow);
      }

      .site-foot {
        margin-top: 90px;
        padding: 40px 0 48px;
        padding-bottom: calc(48px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
        background: linear-gradient(180deg, transparent 0%, rgba(9, 11, 22, 0.7) 100%);
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
      }
      .site-foot p { color: var(--text-low); font-size: 0.95rem; }
      .foot-stamp { font-size: 1rem; }
      .stamp-paw { color: var(--cat-400); margin-right: 2px; }
      .stamp-heart { color: var(--pad-300); margin-left: 2px; }
      .stamp-link {
        color: var(--cat-300);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(45, 212, 167, 0.4);
        transition: all 0.2s;
      }
      .stamp-link:hover {
        color: var(--cat-300);
        text-decoration-color: var(--cat-300);
        text-shadow: 0 0 16px var(--cat-glow);
      }
      .foot-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 6px;
        flex-wrap: wrap;
      }
      .foot-copy { margin: 0; font-size: 0.88rem; }
      .foot-icons {
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }
      .foot-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid var(--cat-400);
        background: var(--night-800);
        color: var(--cat-400);
        box-shadow: 0 0 14px -4px var(--cat-glow);
        transition: all 0.25s cubic-bezier(0.28, 0.84, 0.42, 1);
        cursor: pointer;
      }
      .foot-icon:hover {
        border-color: var(--cat-300);
        color: #fff;
        background: var(--night-700);
        box-shadow: 0 0 20px -2px var(--cat-glow);
        transform: translateY(-2px);
      }
      .foot-icon svg { display: block; }

      :global(.aurora-warm) {
        background:
          radial-gradient(ellipse 90% 60% at 15% -10%, rgba(255, 143, 171, 0.22), transparent 60%),
          radial-gradient(ellipse 80% 50% at 90% 110%, rgba(255, 209, 102, 0.16), transparent 60%),
          radial-gradient(ellipse 65% 65% at 75% 20%, rgba(48, 30, 60, 0.6), transparent 65%),
          linear-gradient(180deg, #0a0710 0%, #120b18 50%, #180f22 100%) !important;
      }

      /* ─────────────────────────────────────────────
         全屏切页 Loader（三阶段动画：入场/循环/出场）
         夜猫系：翡翠绿 cat-500 + 粉肉垫 pad-400 + 深墨蓝底
         动画全部由 JS rAF 状态机驱动（不写死数值，循环任意点可平滑出场）
         ───────────────────────────────────────────── */
      .page-loader {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        background: rgba(6, 8, 16, 0.92);
        /* 静态常驻模糊：不动画 backdrop-filter（WebKit 每帧重采样会卡 + 模糊迟到），
           只淡 opacity（合成层友好）。visibility:hidden 时不渲染、不采样。 */
        backdrop-filter: blur(14px) saturate(150%);
        -webkit-backdrop-filter: blur(14px) saturate(150%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.35s ease, visibility 0.35s ease;
        z-index: 999;
      }
      .page-loader.active {
        opacity: 1;
        visibility: visible;
        pointer-events: all;
      }

      .loader-stage {
        position: relative;
        width: 140px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* 猫爪轮廓脉冲圈：描边猫爪（非圆形），由 JS 控制 transform: scale */
      .pulse-paw {
        position: absolute;
        z-index: 1;
        width: 54px;
        height: 54px;
        fill: none;
        stroke: var(--cat-500);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        filter: drop-shadow(0 0 8px var(--cat-glow));
        opacity: 0.85;
        transform: scale(0); /* JS 驱动，入场从 0 展开 */
        will-change: transform;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
      }

      /* 猫爪图标 + 粉色肉垫（心形掌垫），由 JS 控制 transform: scale */
      .paw-icon {
        position: absolute;
        z-index: 2;
        width: 54px;
        height: 54px;
        fill: var(--cat-500);
        filter: drop-shadow(0 0 4px var(--cat-glow)) drop-shadow(0 0 14px var(--cat-glow));
        transform: scale(0); /* JS 驱动 */
        will-change: transform;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
      }

      .loader-text {
        margin: 0;
        font-size: 13px;
        letter-spacing: 0.1em;
        color: var(--cat-500);
        font-family: var(--font-cute);
        text-shadow: 0 0 8px var(--cat-glow);
        opacity: 0.92;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-loader { display: none !important; }
      }
    </style>
  </body>
</html>
