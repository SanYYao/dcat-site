---
// BaseLayout —— 所有页面的公共骨架
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "死猫的小网站 · dcat.sanyyao.com" } = Astro.props;
const siteTitle = "死猫的小网站";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d18" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="aurora-bg"></div>
    <div class="stars"></div>

    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="brand">
          <span class="brand-paw">🐾</span>
          <span class="brand-name">死猫的小网站</span>
        </a>
        <nav class="head-nav">
          <a href="/">首页</a>
          <a href="/#articles">文章</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="foot-stamp">
          <span class="stamp-paw">🐾</span>
          本喵的互联网小窝 · 被
          <a href="https://www.sanyyao.com" target="_blank" rel="noopener" class="stamp-link">SanYYao</a>
          盖过章的
          <span class="stamp-heart">🖤</span>
        </p>
        <div class="foot-row">
          <p class="foot-copy">© 2026 死猫 · dcat.sanyyao.com</p>
          <div class="foot-icons">
            <a class="foot-icon" href="https://gravatar.com/sanyyaodeadcat" target="_blank" rel="noopener" title="死猫的名片 · Gravatar" aria-label="Gravatar 名片">
              <!-- Gravatar 人形图标 -->
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 1a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm0 8.5c-3.3 0-6 1.8-6 4v1.5h12v-1.5c0-2.2-2.7-4-6-4z"/>
              </svg>
            </a>
            <a class="foot-icon" href="https://github.com/SanYYao/dcat-site" target="_blank" rel="noopener" title="本喵的源码，在 GitHub 上" aria-label="源码仓库">
              <!-- GitHub 官方 Mark SVG，主题色 -->
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: rgba(7, 8, 16, 0.6);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-hi);
        font-weight: 700;
        font-size: 1.05rem;
        font-family: var(--font-cute);
        letter-spacing: 0.02em;
      }
      .brand:hover { color: var(--cat-300); }
      .brand-paw { font-size: 1.1rem; }
      .head-nav {
        display: flex;
        gap: 22px;
        font-size: 0.92rem;
      }
      .head-nav a {
        color: var(--text-mid);
        padding: 4px 2px;
        position: relative;
      }
      .head-nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 0;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--cat-400), var(--pad-300));
        transition: width 0.25s ease;
      }
      .head-nav a:hover { color: var(--cat-300); }
      .head-nav a:hover::after { width: 100%; }

      .site-foot {
        margin-top: 90px;
        padding: 36px 0 44px;
        padding-bottom: calc(44px + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--line);
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        text-align: center;
      }
      .site-foot p { color: var(--text-low); font-size: 0.95rem; }
      .foot-stamp { font-size: 1rem; }
      .stamp-paw { color: var(--cat-400); }
      .stamp-heart { color: var(--pad-300); }
      .stamp-link {
        color: var(--cat-300);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(45, 212, 167, 0.4);
        transition: all 0.2s;
      }
      .stamp-link:hover {
        color: var(--cat-300);
        text-decoration-color: var(--cat-300);
        text-shadow: 0 0 16px var(--cat-glow);
      }
      .foot-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-top: 8px;
        flex-wrap: wrap;
      }
      .foot-copy { margin: 0; }
      .foot-icons {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .foot-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        /* MBE 风格：粗描边 + 圆润 */
        border: 2.5px solid var(--cat-400);
        background: var(--night-800);
        color: var(--cat-400);
        box-shadow: 0 0 14px -4px var(--cat-glow);
        transition: all 0.25s ease;
      }
      .foot-icon:hover {
        border-color: var(--cat-300);
        color: var(--cat-300);
        background: var(--night-700);
        box-shadow: 0 0 24px -4px var(--cat-glow);
        transform: translateY(-2px) rotate(-6deg);
      }
      .foot-icon svg { display: block; }
    </style>
  </body>
</html>
